NODE_ENV=development
PORT=4000

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

DIKE_CONTRACTS_ROOT=../dike-contracts
DIKE_MANIFEST_PATH=./deployments/testnet.json

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dike_services
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=change-me

# Required for the first run against an empty DB. Use a retained deployment ledger.
# 3444840 = just before the 2026-07-05 testnet redeploy (11 new contract IDs, upgrade() added).
INDEXER_START_LEDGER=3444840
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_LEDGER_WINDOW=250
RECONCILIATION_INTERVAL_MS=60000
INDEXER_LAG_ALERT_THRESHOLD=50

# Fee sponsorship is disabled until the sponsor account is funded and tested.
FEE_SPONSOR_ENABLED=false
# Never commit a real seed. Inject this at runtime only when enabled.
FEE_SPONSOR_SEED=
FEE_SPONSOR_BASE_FEE_STROOPS=2000000
FEE_SPONSOR_MAX_TOTAL_FEE_STROOPS=10000000
FEE_SPONSOR_MAX_RESOURCE_FEE_STROOPS=8000000
FEE_SPONSOR_MAX_PER_MINUTE=10
FEE_SPONSOR_MAX_PER_IP_MINUTE=30
FEE_SPONSOR_DAILY_BUDGET_STROOPS=100000000
FEE_SPONSOR_REPLAY_TTL_SECONDS=900
FEE_SPONSOR_LOCK_TTL_SECONDS=30
FEE_SPONSOR_CONFIRMATION_TIMEOUT_SECONDS=120
