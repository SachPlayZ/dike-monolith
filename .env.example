# Keep all network values aligned. NEXT_PUBLIC_* values are bundled at build time.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_DIKE_MANIFEST_NETWORK=testnet
NEXT_PUBLIC_DIKE_SERVICES_URL=http://localhost:4000

# Server-only key for protected governance reads. Never prefix this with NEXT_PUBLIC_.
DIKE_ADMIN_API_KEY=
