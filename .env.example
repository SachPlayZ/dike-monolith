# scripts/deploy-testnet.sh reads these as shell env vars (not dotenv-loaded —
# `export` them or prefix the command, e.g. `NETWORK=testnet ./scripts/deploy-testnet.sh`).
# This file documents the available vars and their defaults; it is not sourced automatically.

# Network + signing identities (must exist via `stellar keys generate/add`)
NETWORK=testnet
SOURCE=alice
ADMIN=$SOURCE
TREASURY=$SOURCE
PROPOSER=$SOURCE
EXECUTOR=$SOURCE
GOV_AUTH=$SOURCE

# Collateral: set ONE of these. USDC_ISSUER takes priority; if it looks like a
# Stellar asset issuer (G...) it's used to derive the SAC via `stellar contract id asset`.
# Leave both empty + ALLOW_MOCK_USDC=true for local/dev-only deploys.
COLLATERAL_CONTRACT=
ASSET_CODE=USDC
USDC_ISSUER=
ALLOW_MOCK_USDC=false
DEPLOY_SAC=false

# Post-deploy: register an additional approved creator + council member
# (beyond SOURCE, which is always registered as creator).
EXTRA_CREATOR=
EXTRA_COUNCIL_MEMBER=

# Protocol params
MIN_DELAY=0
GRACE_PERIOD=604800
MINIMUM_BOND=10000000
BOND_BPS=100
MIN_LIQUIDITY=10000000
MIN_EXPIRY_DURATION=60

# Deploy mechanics
DEPLOY_DIR=deployments
ALIAS_PREFIX=dike-$NETWORK-opt
TX_SLEEP=8
DEPLOY_RETRIES=3
INVOKE_RETRIES=3
FEE=1000000
SKIP_BUILD=false
